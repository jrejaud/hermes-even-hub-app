# DEV-ONLY bridge defaults, adopted when nothing is stored yet.
#
# Production entry is the phone setup form at runtime — leave these empty for a
# real build. They are read only when `import.meta.env.DEV` is true, which is
# false for `vite build`, so a packed .ehpk can never carry a token even if this
# file exists on the machine that packed it. That matters: anyone with the
# package can extract whatever is bundled in it.
#
# `npm --prefix bridge start` then `node bridge/cli.mjs app-env` writes the
# .env.local these describe, resolving the token without putting it on a
# command line.
VITE_BRIDGE_URL=
VITE_BRIDGE_TOKEN=
